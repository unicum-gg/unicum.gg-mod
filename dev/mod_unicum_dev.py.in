"""Dev bootstrap for the unicum.gg mod. Generated by tools/install_dev.py.

The client loads this file once at startup, from a .wotmod. It is
deliberately the only piece of the mod that lives inside the game, and it
holds nothing but the loader and the reload loop: every part that changes
lives under SRC_ROOT and is reimported in place, so editing the mod never
costs a client restart.

Sources are loaded by an explicit finder on sys.meta_path rather than by
putting SRC_ROOT on sys.path. BigWorld resolves sys.path entries through
ResMgr, against the client's virtual resource tree, so a plain filesystem
directory there is simply never found -- `os.walk` sees the files and
`import` does not. Reading and compiling the sources ourselves sidesteps
that, and has a second benefit: nothing consults or writes .pyc files, so a
fix saved moments after a broken save can never be masked by stale bytecode.

Do not edit this file. Edit the sources under SRC_ROOT and save.
"""
import imp
import logging
import os
import sys
import traceback

import BigWorld

# What an error reporter reads off a mod's module; the package's own version
# lives in src/unicum/__init__.py, and the release entry carries the released
# one (dev/mod_unicum.py.in).
__version__ = '0.0.0-dev'

SRC_ROOT = r'__SRC_ROOT__'
PACKAGE = 'unicum'
POLL_SECONDS = 0.5

_logger = logging.getLogger('unicum.bootstrap')

_generation = 0
_signature = None
_loaded = None
_watching = False
_tick_handle = None
_finder = None


class SourceFinder(object):
    """Imports one package straight off the real filesystem.

    Implements the Python 2 finder/loader protocol so that ordinary imports
    inside the package -- `from unicum.runtime.session import Session` --
    keep working, without the sources having to know they are being loaded
    unusually.
    """

    def __init__(self, package, root):
        self.package = package
        self.root = root

    def find_module(self, fullname, path=None):
        if fullname != self.package and not fullname.startswith(self.package + '.'):
            return None
        return self if self._resolve(fullname) else None

    def load_module(self, fullname):
        if fullname in sys.modules:
            return sys.modules[fullname]
        resolved = self._resolve(fullname)
        if resolved is None:
            raise ImportError('no source for %s under %s' % (fullname, self.root))
        path, is_package = resolved

        module = imp.new_module(fullname)
        module.__file__ = path
        module.__loader__ = self
        if is_package:
            module.__path__ = [os.path.dirname(path)]
            module.__package__ = fullname
        else:
            module.__package__ = fullname.rpartition('.')[0]

        # Registered before execution because a module that imports its own
        # siblings has to be findable while its body is still running.
        sys.modules[fullname] = module
        try:
            with open(path, 'rU') as handle:
                source = handle.read()
            exec compile(source, path, 'exec') in module.__dict__
        except Exception:
            del sys.modules[fullname]
            raise
        return module

    def _resolve(self, fullname):
        """Map a dotted name to a file, and say whether it is a package."""
        relative = fullname.split('.')
        base = os.path.join(self.root, *relative)
        package_init = os.path.join(base, '__init__.py')
        if os.path.isfile(package_init):
            return (package_init, True)
        module_file = base + '.py'
        if os.path.isfile(module_file):
            return (module_file, False)
        return None


def init():
    """Called by the client's mod loader once scripts are importable."""
    global _finder
    if not os.path.isdir(SRC_ROOT):
        _logger.error('source root not found, mod disabled: %s', SRC_ROOT)
        return
    _finder = SourceFinder(PACKAGE, SRC_ROOT)
    sys.meta_path.insert(0, _finder)
    _load()
    _watch()


def fini():
    """Called on client shutdown."""
    global _watching, _tick_handle, _finder
    _watching = False
    if _tick_handle is not None:
        # The tick would no-op on the `_watching` flag anyway, but leaving a
        # registered callback behind during teardown is exactly what this
        # mod asks every one of its own features not to do.
        BigWorld.cancelCallback(_tick_handle)
        _tick_handle = None
    _unload()
    if _finder is not None and _finder in sys.meta_path:
        sys.meta_path.remove(_finder)
    _finder = None


def _watch():
    global _watching, _signature, _tick_handle
    if _watching:
        return
    _watching = True
    _signature = _scan()
    _logger.info('watching %s every %.1fs', SRC_ROOT, POLL_SECONDS)
    _tick_handle = BigWorld.callback(POLL_SECONDS, _tick)


def _tick():
    global _signature, _tick_handle
    _tick_handle = None
    if not _watching:
        return
    try:
        signature = _scan()
        if signature != _signature:
            _signature = signature
            _reload()
    except Exception:
        _logger.error('watcher tick failed:\n%s', traceback.format_exc())
    _tick_handle = BigWorld.callback(POLL_SECONDS, _tick)


def _scan():
    """Fingerprint every source file under SRC_ROOT.

    Size is part of the fingerprint because mtime alone is not fine-grained
    enough: two writes close together can land on the same timestamp, and
    the edit that follows a failed reload by a fraction of a second is
    exactly the case that must not be missed.
    """
    entries = []
    for dirpath, dirnames, filenames in os.walk(SRC_ROOT):
        dirnames[:] = [d for d in dirnames if d not in ('.git', '__pycache__')]
        for name in filenames:
            if not name.endswith('.py'):
                continue
            path = os.path.join(dirpath, name)
            try:
                info = os.stat(path)
            except OSError:
                # Renamed or replaced between listing and stat, which is what
                # an editor's atomic save looks like. The next tick sees the
                # settled tree.
                continue
            entries.append((path, info.st_mtime, info.st_size))
    entries.sort()
    return tuple(entries)


def _reload():
    global _generation
    _logger.info('source change detected, reloading')
    _unload()
    _purge()
    _generation += 1
    _load()


def _load():
    global _loaded
    try:
        module = __import__(PACKAGE)
        module.start(_generation)
        _loaded = module
    except Exception:
        _loaded = None
        # A syntax error in a half-written file is the common case here.
        # Swallowing it keeps the watcher alive so the next save can fix it,
        # rather than costing a client restart over a typo.
        _logger.error('load failed at generation %s:\n%s',
                      _generation, traceback.format_exc())


def _unload():
    global _loaded
    if _loaded is None:
        return
    try:
        _loaded.stop()
    except Exception:
        # Reported but not re-raised: a session that fails to tear down
        # cleanly must still not block the next load.
        _logger.error('stop failed:\n%s', traceback.format_exc())
    finally:
        _loaded = None


def _purge():
    """Drop the package so the next import rebuilds it from source."""
    prefix = PACKAGE + '.'
    for name in list(sys.modules):
        if name == PACKAGE or name.startswith(prefix):
            del sys.modules[name]
