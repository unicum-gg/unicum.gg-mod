<?xml version="1.0" encoding="utf-8"?>
<!-- Compiles as3/src against the client's own classes, linked externally:
     they are already loaded in the lobby, so the SWF carries only our code.
     The libs folder is filled by tools/build_as3.py. -->
<royale-config>
  <target-player>17.0</target-player>
  <swf-version>17</swf-version>

  <compiler>
    <targets>
      <target>SWF</target>
    </targets>

    <source-path append="true">
      <path-element>src</path-element>
    </source-path>

    <library-path></library-path>

    <external-library-path>
      <path-element>../build/as3/libs/base_app-1.0-SNAPSHOT.swc</path-element>
      <path-element>../build/as3/libs/common_i18n_library-1.0-SNAPSHOT.swc</path-element>
      <path-element>../build/as3/libs/common-1.0-SNAPSHOT.swc</path-element>
      <path-element>../build/as3/libs/gui_base-1.0-SNAPSHOT.swc</path-element>
      <path-element>../build/as3/libs/gui_lobby-1.0-SNAPSHOT.swc</path-element>
      <path-element>../build/as3/libs/lobby.swc</path-element>
      <path-element>../build/as3/libs/playerglobal.swc</path-element>
    </external-library-path>

    <as3>true</as3>
    <es>false</es>
    <verbose-stacktraces>true</verbose-stacktraces>
  </compiler>
</royale-config>
